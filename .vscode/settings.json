{
    "cSpell.words": [
        "AUTOSCRIPT",
        "BIRT",
        "Charsets",
        "DISCARDABLE",
        "domainid",
        "errorgroup",
        "errorkey",
        "evalresult",
        "fnames",
        "Huizen",
        "maxauth",
        "mboname",
        "mboset",
        "mbovalue",
        "Nashorn",
        "Naviam",
        "onadd",
        "ondelete",
        "oslc",
        "Sharptree",
        "thisvalue",
        "typeofs",
        "wfinstance"
    ],
    "json.schemas": [
        {
            "fileMatch": [
                "*.predeploy.json",
                "*-predeploy.json"
            ],
            "url": "./.vscode/predeploy-schema.json"
        },
        {
            "fileMatch": [
                "test/complete/configuration/*.json",
                "test/integration/fixtures/*.json"
            ],
            "url": "./.vscode/deploy-schema.json"
        },
        {
            "fileMatch": [
                ".devtools-config.json"
            ],
            "url": "./.vscode/devtools-config-schema.json"
        },
        {
            "fileMatch": [
                "*.manifest.json",
                "*-manifest.json"
            ],
            "url": "./.vscode/manifest-schema.json"
        }
    ],
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "prettier.trailingComma": "none",
    "files.associations": {
        "*.dbc": "xml"
    },
    "java.configuration.updateBuildConfiguration": "disabled"
}