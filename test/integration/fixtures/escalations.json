{
    "actions": [
        {
            "action": "TEST_REPORTJOB_HOST",
            "description": "Set the report job host name",
            "type": "!SETVALUE!",
            "useWith": "!ALL!",
            "objectName": "REPORTJOB",
            "parameter": "HOSTNAME",
            "value": "TESTHOST"
        },
        {
            "action": "TEST_REPORTJOB_GRP",
            "description": "Escalation actions for long running reports",
            "type": "!GROUP!",
            "useWith": "!ESCALATION!",
            "objectName": "REPORTJOB",
            "actionGroup": [
                {
                    "member": "TEST_REPORTJOB_HOST",
                    "sequence": 1
                }
            ]
        }
    ],
    "escalations": [
        {
            "escalation": "TEST_REPORTLONG",
            "description": "Integration test escalation for a long running report",
            "objectName": "REPORTJOB",
            "condition": "",
            "active": true,
            "schedule": "2h,*,0,*,*,*,*,*,*,*",
            "cronTaskName": "ESCALATION",
            "instanceName": "TEST_REPORTLONGESC",
            "escStatusFlag": true,
            "escRefPoint": [
                {
                    "refPointNum": 1,
                    "eventAttribute": "STARTTIME",
                    "elapsedInterval": 10,
                    "intervalUom": "!MINUTES!",
                    "repeat": false,
                    "eventCondition": "reportname is not null",
                    "action": "TEST_REPORTJOB_GRP",
                    "escNotification": [
                        {
                            "templateId": "NVTESTESCBASIC"
                        }
                    ]
                },
                {
                    "refPointNum": 2,
                    "eventAttribute": "LASTACTIVETIME",
                    "elapsedInterval": 20,
                    "intervalUom": "!HOURS!",
                    "repeat": true
                }
            ]
        }
    ]
}
